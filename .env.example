# Copy this file to .env and fill in your values. Never commit .env.

# Anthropic API key for AI-assisted analysis (summaries, risk diff classification,
# red-flag review). Without a key the tool falls back to deterministic heuristics.
ANTHROPIC_API_KEY=

# Optional: override the model used for analysis.
ANTHROPIC_MODEL=claude-sonnet-5

# REQUIRED by the SEC. EDGAR demands a User-Agent that identifies you with a
# contact e-mail address (https://www.sec.gov/os/accessing-edgar-data).
# Format: "Product/Version (contact@example.com)" or "Your Name contact@example.com"
SEC_USER_AGENT=sec-filing-analyzer/0.1 (your.name@example.com)

# Optional: max requests per second against EDGAR (SEC hard limit is 10).
SEC_MAX_REQUESTS_PER_SECOND=5

# ---------------------------------------------------------------------------
# Optional n8n proxy backend (advanced, opt-in).
#
# Only needed if outbound access to sec.gov is blocked in your environment and
# you route requests through your OWN self-hosted n8n workflow. Leave as
# "edgar" for normal direct access. See examples/n8n/README.md.
#
# SECURITY: these point at YOUR private n8n instance. They must be set via the
# environment only and must NEVER be committed. The webhook must require the
# Bearer token below so it is not an open relay.
SEC_BACKEND=edgar
# N8N_WEBHOOK_URL=https://your-n8n-host.example/webhook/edgar-proxy
# N8N_AUTH_TOKEN=change-me-to-a-long-random-secret
